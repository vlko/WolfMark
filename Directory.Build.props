<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;sk</SatelliteResourceLanguages>
    <!-- AOT tuned for speed (static PGO, vxsort) and runtime-native async (.NET 11), see docs/adr/0006-build-size.md. -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <Features>$(Features);runtime-async=on</Features>

    <!-- Domain libraries are plain net11.0 so they build and test on any OS (CI, Linux dev boxes). -->
    <WolfMarkCoreTargetFramework>net11.0</WolfMarkCoreTargetFramework>
    <WolfMarkWindowsTargetFramework>net11.0-windows10.0.22621.0</WolfMarkWindowsTargetFramework>
  </PropertyGroup>

  <!--
    Non-Windows hosts (Linux CI, WSL) can compile the WinUI projects' C# for type checking, but the
    Windows-only packaging tools (MakePri.exe) cannot run there. Real builds happen on Windows.
  -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- CA rules that are noise for this code base. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1848;CA1303;CA1716;CA1711;CA1720;CA1724;CA1031;CA2007;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1515;CA1812;CA1859;CA1822;CA1852;CA1823;CA1805;CA1508;CA1002;CA2227;CA1056;CA1054;CA1055;CA1032;CA1034;CA1003;CA1063;CA1816;CA1001;CA2000;CA2213;CA5394;CA1865;CA1866;CA1847;CA1849;CA1873</NoWarn>
  </PropertyGroup>
</Project>
