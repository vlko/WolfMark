<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <!-- Canvas editor (docs/adr/0007-canvas-editor.md); depends only on the WinUI component. -->
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- macOS/Linux app (src/WolfMark.Desktop); AOT-checked: docs/adr/0005-avalonia-port.md -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Windows App SDK 2.6.5 components the app uses; the metapackage would also bundle AI, ML
         (onnxruntime, DirectML), Search and Widgets runtimes into the self-contained output. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.6.5" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
