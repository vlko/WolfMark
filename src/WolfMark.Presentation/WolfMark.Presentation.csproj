<Project Sdk="Microsoft.NET.Sdk">
  <!--
    View models, AppHost and UI-neutral infrastructure shared by the Windows app (WinUI) and the
    macOS/Linux app (Avalonia). No UI framework here – the hosts plug in the UI thread and string lookup.
  -->
  <PropertyGroup>
    <TargetFramework>$(WolfMarkCoreTargetFramework)</TargetFramework>
    <RootNamespace>WolfMark.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WolfMark.Core\WolfMark.Core.csproj" />
    <ProjectReference Include="..\WolfMark.Storage\WolfMark.Storage.csproj" />
    <ProjectReference Include="..\WolfMark.Index\WolfMark.Index.csproj" />
    <ProjectReference Include="..\WolfMark.Sync.ClaudeCode\WolfMark.Sync.ClaudeCode.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WolfMark" />
    <InternalsVisibleTo Include="WolfMark.Desktop" />
    <InternalsVisibleTo Include="WolfMark.Presentation.Tests" />
  </ItemGroup>
</Project>
