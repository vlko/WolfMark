<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(ZapisnikCoreTargetFramework)</TargetFramework>
    <RootNamespace>Zapisnik.Index</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zapisnik.Core\Zapisnik.Core.csproj" />
    <ProjectReference Include="..\Zapisnik.Storage\Zapisnik.Storage.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Only the native vec0 binaries are needed; we load the extension ourselves. -->
    <PackageReference Include="sqlite-vec" ExcludeAssets="contentFiles;build" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zapisnik.Index.Tests" />
  </ItemGroup>
</Project>
