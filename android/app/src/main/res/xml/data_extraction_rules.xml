<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app is backed up or moved to another phone: the notes are in OneDrive, the sign-in belongs to
     this device, and a queued share restored elsewhere could be delivered twice. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
